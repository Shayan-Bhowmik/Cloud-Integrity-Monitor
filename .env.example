# Copy to .env (repo root). One file serves the backend and the frontend.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# ---- Backend (secret — never expose to the frontend) -------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Legacy HS256 secret. Projects using asymmetric JWT signing keys (ES256) are verified
# automatically through SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET=generate-a-random-32-byte-hex-or-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=10

# ---- Frontend (public by design) --------------------------------------------
# Used by `npm run dev`. The Docker image ignores it and calls the API through nginx (same origin).
VITE_API_URL=http://localhost:8000
# Must be the same project as SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
